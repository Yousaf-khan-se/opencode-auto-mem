{
  "name": "opencode-auto-mem",
  "version": "2.4.6",
  "description": "Markdown-based persistent memory plugin for OpenCode — background memory-keeper agent, configurable trigger modes, project-scoped semantic search",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node tests/smoke-test.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "markdown"
  ],
  "author": "Muhammad Yousaf (https://github.com/Yousaf-khan-se)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yousaf-khan-se/opencode-auto-mem.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@huggingface/transformers": "4.0.0-next.4",
    "vectra": "^0.12.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.27 || >=2.0.0-beta"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "overrides": {
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^22.19.11",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
